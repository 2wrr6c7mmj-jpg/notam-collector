{
  "name": "notam-collector",
  "private": true,
  "type": "module",
  "description": "Collects public NOTAM and navigational-warning data for NOTAM Watch on GitHub Actions.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "collect": "node --no-warnings --experimental-transform-types --import ./runtime/register.mjs collect.mjs",
    "test": "node --no-warnings --experimental-transform-types --import ./runtime/register.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "fflate": "0.7.4",
    "polygon-clipping": "0.15.7",
    "unpdf": "1.9.1"
  }
}
